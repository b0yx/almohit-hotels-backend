# Almohit Hotels — Next.js Frontend Environment Variables
# Copy to .env.local in your Next.js project root

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api

NEXT_PUBLIC_AUTH_SCHEME=Bearer
NEXT_PUBLIC_TOKEN_STORAGE=localStorage

NEXT_PUBLIC_APP_NAME=Almohit Hotels
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_TENANT_HEADER=X-Hotel-Subdomain

NEXT_PUBLIC_MAX_IMAGE_SIZE=5
NEXT_PUBLIC_ACCEPTED_IMAGE_TYPES=image/jpeg,image/png,image/webp

NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100
